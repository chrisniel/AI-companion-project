# =========================================================
# AI Companion Project
# .gitattributes
# =========================================================

# Normalize text files in Git.
* text=auto

# Use LF in repository for source/config/docs.
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.py      text eol=lf
*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.xml     text eol=lf
*.sql     text eol=lf
*.sh      text eol=lf

# PowerShell and Windows command files use CRLF.
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Common binaries.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.7z      binary
*.wav     binary
*.mp3     binary
*.ogg     binary
*.opus    binary

# -----------------------------------------------------------------
# Active Git LFS Patterns for AI Companion Project
# -----------------------------------------------------------------
#
# IMPORTANT:
# These are the active Git LFS model-artifact patterns for this repo.
# GitHub remains the canonical Git source/history repository.
# .lfsconfig explicitly directs LFS object transfer to the approved
# private Hugging Face dataset endpoint.
#
# The patterns do not constitute permission to commit arbitrary
# downloaded model files. Large artifacts must be deliberately
# approved and added. Enabling additional tracked formats such as
# *.bin or *.model is a storage-policy change requiring explicit
# user approval under ADR-0001.
#
# AI / ML model files
*.gguf        filter=lfs diff=lfs merge=lfs -text
*.ggml        filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.onnx        filter=lfs diff=lfs merge=lfs -text
*.pt          filter=lfs diff=lfs merge=lfs -text
*.pth         filter=lfs diff=lfs merge=lfs -text
*.ckpt        filter=lfs diff=lfs merge=lfs -text
#
# Optional large voice/avatar model assets:
# *.bin         filter=lfs diff=lfs merge=lfs -text
# *.model       filter=lfs diff=lfs merge=lfs -text
