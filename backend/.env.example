# ==============================================================================
# Local AI Core Environment Configuration
# ==============================================================================
# In production/local use, copy this file to `.env`:
# cp .env.example .env
#
# If COMPANION_API_KEY is left blank, the server will auto-generate a secure
# 32-byte URL-safe pairing token on first launch and write it here.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Security & Pairing
# Auto-generated on startup if left empty
COMPANION_API_KEY=

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SQLite Database Location
DATABASE_URL=sqlite+aiosqlite:///./data/companion.db
DATA_DIR=./data
