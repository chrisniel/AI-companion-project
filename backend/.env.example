# ==============================================================================
# Local AI Runtime Environment Configuration
# ==============================================================================
# In production/local use, copy this file to `.env`:
# cp .env.example .env
#
# If COMPANION_API_KEY is left blank, the server will auto-generate a secure
# 32-byte URL-safe pairing token on first launch and write it here.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Security & Pairing
# Auto-generated on startup if left empty
COMPANION_API_KEY=

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SQLite Database Location
DATABASE_URL=sqlite+aiosqlite:///./data/companion.db
DATA_DIR=./data

# Runtime Engine & Hardware Performance Profiles (Optional overrides)
# LLM_ENGINE=llama_cpp
# LLM_ACCELERATION=vulkan
# LLAMA_ENGINE_VERSION=b10936
#
# Profile Defaults (calibrated for AMD RX 580 8GB):
# PROFILE_ECO_CTX=2048
# PROFILE_ECO_GPU_LAYERS=0
# PROFILE_ECO_THREADS=4
# PROFILE_ECO_MMPROJ_OFFLOAD=false
#
# PROFILE_BALANCED_CTX=4096
# PROFILE_BALANCED_GPU_LAYERS=28
# PROFILE_BALANCED_THREADS=6
# PROFILE_BALANCED_MMPROJ_OFFLOAD=true
#
# PROFILE_MAXIMUM_CTX=8192
# PROFILE_MAXIMUM_GPU_LAYERS=33
# PROFILE_MAXIMUM_THREADS=8
# PROFILE_MAXIMUM_MMPROJ_OFFLOAD=true
